[Unit]
Description=Termo Online API (FastAPI)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/termo-online
Environment=PORT=8001
Environment=TERM0_API_ONLY=1
Environment=TERM0_RELOAD=0
Environment=TERM0_DATA=/root/termo-online/data
Environment=TERM0_CORS_ORIGINS=https://termo.cloudive.com.br,http://localhost:8000
Environment=TERM0_LOG_LEVEL=INFO
Environment=TERM0_REDIS_URL=redis://127.0.0.1:6379/0
ExecStart=/root/termo-online/.venv/bin/python -m uvicorn main:Aplicacao --host 0.0.0.0 --port 8001 --app-dir /root/termo-online/src
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
