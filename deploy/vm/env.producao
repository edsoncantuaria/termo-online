# Copiar para /root/termo-online/.env na VM (opcional; systemd já define o essencial)
PORT=8001
TERM0_API_ONLY=1
TERM0_RELOAD=0
TERM0_DATA=/root/termo-online/data
TERM0_CORS_ORIGINS=https://termo.cloudive.com.br
TERM0_LOG_LEVEL=INFO
TERM0_MAX_WS_SALA=700
TERM0_MAX_WS_LOBBY=400
TERM0_MAX_SALAS=280
TERM0_MAX_FILA_RANQUEADA=150
TERM0_MAX_FILA_ESPERA=200
TERM0_ESPERA_SLOT_SEG=3
# TERM0_REDIS_URL=redis://127.0.0.1:6379/0
# TERM0_WORKER_ID=api-1
